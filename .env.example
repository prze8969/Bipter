# Bipter — copy to .env.local. Throwaway DEVNET keys only. Never commit real keys.

# "devnet" (default, real program) or "simulated" (LOCAL DEV ONLY, nothing on-chain)
NEXT_PUBLIC_CHAIN_MODE=devnet

# Devnet RPC
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# From Solana Playground after deploying program/lib.rs
NEXT_PUBLIC_PROGRAM_ID=

# Written by `npm run setup:devnet`
NEXT_PUBLIC_USDC_MINT=
NEXT_PUBLIC_MERCHANT=
NEXT_PUBLIC_SPONSOR=

# Server-only secrets, base58 secret keys (devnet throwaway). `npm run gen:keys` fills empty ones.
# SPONSOR_SECRET: funded key that sends 1 devnet SOL from "Get devnet SOL"
# MINT_AUTHORITY_SECRET: mint authority of the test USDC mint (faucet)
# ADMIN_SECRET: pool admin (setup, demo fast-forward)
SPONSOR_SECRET=
MINT_AUTHORITY_SECRET=
ADMIN_SECRET=
