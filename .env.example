# Bipter — copy to .env.local. Throwaway DEVNET keys only. Never commit real keys.

# "simulated" (in-browser, default) or "devnet" (real program)
NEXT_PUBLIC_CHAIN_MODE=simulated

# Devnet RPC
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# From Solana Playground after deploy (M2)
NEXT_PUBLIC_PROGRAM_ID=

# Filled by `npm run setup:devnet` (M3)
NEXT_PUBLIC_USDC_MINT=
NEXT_PUBLIC_MERCHANT=
NEXT_PUBLIC_SPONSOR=

# Server-only secrets, base58 secret keys (devnet throwaway)
SPONSOR_SECRET=
MINT_AUTHORITY_SECRET=
ADMIN_SECRET=
